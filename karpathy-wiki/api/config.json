    "incrementalCrawl": false,
    "incrementalStatePath": "../data/url-crawl-state.json",
    "resumeCrawl": false
  },
  "media": {
    "agnes": {
      "baseUrl": "https://apihub.agnes-ai.com/v1",
      "apiKeyRef": "AGNES_API_KEY",
      "imageModel": "agnes-image-2.1-flash",
