{
  "_meta": {
    "file": "project_config.json",
    "purpose": "Xianyu Hunter（闲鱼猎人）项目特定配置（与通用配置 core_config.json 配合使用）",
    "version": "2.4.0",
    "schema_version": "2.4.0",
    "last_updated": "2026-07-22"
  },
  "project": {
    "key": "xianyu_hunter",
    "name": "Xianyu Hunter",
    "base_path": ".",
    "description": "闲鱼猎人：FastAPI 后端 + React 前端 + 移动端 H5"
  },
  "business_constraints": {
    "_description": "业务特定硬约束文件加载清单。文件位于 config/hard_constraints/business/ 目录，按本清单顺序加载并合并到 core.json 之上。支持多项目并行：每个项目独立配置自己的业务约束，互不污染。",
    "load_files": ["xianyu.json"]
  },
  "modules": {
    "backend": {
      "path": "src/xianyu_hunter",
      "languages": ["python"],
      "frameworks": ["fastapi"],
      "layers": {
        "api": "api",
        "core": "core",
        "models": "models",
        "services": "services",
        "utils": "utils",
        "web": "web",
        "config": "config"
      },
      "exclude": ["web/static", "web/templates", "__pycache__", "node_modules", ".git", "dist", "build", "tests"]
    },
    "frontend": {
      "path": "frontend/src",
      "languages": ["typescript", "javascript"],
      "frameworks": ["react"],
      "layers": {
        "components": "components",
        "pages": "pages",
        "hooks": "hooks",
        "utils": "utils",
        "services": "services",
        "types": "types",
        "store": "store",
        "mobile": "mobile"
      },
      "exclude": ["node_modules", "dist", "build", "__tests__"]
    }
  },
  "sonar_project_properties": {
    "_description": "对应项目根目录 sonar-project.properties 文件的关键配置，供 detect-project.ps1 和 validate-config.ps1 校验",
    "projectKey": "xianyu_hunter",
    "sources": "src/xianyu_hunter,frontend/src",
    "tests": "tests",
    "python_version": "3.10",
    "tsconfig_path": "frontend/tsconfig.json",
    "coverage_report_paths": "coverage.xml"
  },
  "verify": {
    "test_command": "pytest tests/",
    "test_commands": {
      "_description": "分模块测试命令（推荐，替代单一 test_command 拼接）",
      "backend": "pytest tests/",
      "frontend": "cd frontend && npx tsc --noEmit"
    },
    "typecheck_command": "cd frontend && npx tsc --noEmit"
  },
  "report": {
    "output_dir": "docs/04-系统维护/sonar-reports/"
  },
  "framework_extensions": {
    "_deprecated": "v2.0 起框架模式统一从 config/framework_patterns.json 加载，不再使用此字段",
    "fastapi_decorators": [
      "@app.get", "@app.post", "@app.put", "@app.delete", "@app.patch",
      "@router.get", "@router.post", "@router.put", "@router.delete", "@router.patch",
      "@app.websocket", "@app.on_event", "@app.middleware"
    ],
    "react_patterns": ["useEffect", "useState", "useCallback", "useMemo", "React.memo"]
  },
  "fix_strategies_overrides": {
    "_description": "项目级修复策略覆盖（与 config/fix_strategies.json 配合使用）",
    "data_source": "基于 xianyu_hunter 项目 2026-07-22 实战扫描结果分布（100+ OPEN 问题，最终收敛到 0）",
    "high_frequency_rules": [
      "typescript:S6759 (React props readonly)",
      "typescript:S3358 (嵌套三元)",
      "typescript:S6551 (对象字符串化误报)",
      "typescript:S6544 (Promise 返回函数)",
      "typescript:S6819 (role=button 可访问性)",
      "python:S3776 (认知复杂度过高)"
    ],
    "rule_overrides": {}
  },
  "quality_gate_baseline": {
    "_description": "2026-07-22 实战后的质量门基线，用于后续扫描对比",
    "scan_date": "2026-07-22",
    "open_issues_after_fix": 0,
    "new_violations": 0,
    "pending_metrics": {
      "new_coverage": "18.5% (目标 80%，需补充单元测试)",
      "new_security_hotspots_reviewed": "0% (目标 100%，需手动 UI 审查)"
    },
    "tests_passed": "1613 python tests + tsc --noEmit"
  }
}
